# Serveur
PORT=8080
JWT_SECRET=changez-moi-en-production
JWT_EXPIRES_IN=24h

# Base de données : sqlite (défaut) ou postgres
DB_DRIVER=sqlite

# SQLite : chemin du fichier de base (le volume Docker /data le rend persistant)
DB_PATH=smartcampus.db

# PostgreSQL : renseigner DATABASE_URL pour activer automatiquement le driver pg
# DATABASE_URL=postgres://smartcampus:smartcampus@localhost:5433/smartcampus
